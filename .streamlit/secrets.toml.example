# Copy to .streamlit/secrets.toml for local testing (gitignored), or paste into
# Streamlit Community Cloud > App settings > Secrets. Never commit real values.
#
# The user is the key-pair service user created by scripts/public_app_access.sql.
# private_key is the full PKCS#8 PEM, including the BEGIN/END lines.

[snowflake]
account = "<ORG>-<ACCOUNT>"
user = "COPILOT_PUBLIC_SVC"
role = "COPILOT_PUBLIC_ROLE"
warehouse = "COPILOT_PUBLIC_WH"
database = "RISK_DB"
private_key = """
-----BEGIN PRIVATE KEY-----
<key body>
-----END PRIVATE KEY-----
"""
